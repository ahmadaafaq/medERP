# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_super_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=unicampus-erp-files

# ─── Email (BullMQ / SMTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@unicampus.app
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=UniCampus ERP

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8081
NEXTAUTH_SECRET=change_me_nextauth_secret_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
NEXT_OUTPUT_STANDALONE =true

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://*.unicampus.app

# ─── Throttler ───────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Sentry (optional) ───────────────────────────────────────────────────────
SENTRY_DSN=
