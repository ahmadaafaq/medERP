# ==============================================================================
# UNICAMPUS ERP — BACKEND CONFIGURATION
# ==============================================================================

# ─── App Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# For Local DB:      DB_HOST=localhost,     DB_PORT=5432, DB_USER=postgres,  DB_PASS=postgres, DB_NAME=unicampus_erp
# For Remote Live:   DB_HOST=34.236.107.120, DB_PORT=5433, DB_USER=unicampus,  DB_PASS=unicampus_dev@qsd!3ous, DB_NAME=unicampus_erp
DB_HOST=34.236.107.120
DB_PORT=5433
DB_USER=unicampus
DB_PASS=unicampus_dev@qsd!3ous
DB_NAME=unicampus_erp

# ─── Redis Cache ──────────────────────────────────────────────────────────────
# For Local Redis:   REDIS_HOST=127.0.0.1,     REDIS_PORT=6379
# For Remote Redis:  REDIS_HOST=34.236.107.120, REDIS_PORT=6379
REDIS_HOST=34.236.107.120
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_super_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── AWS S3 (File Storage) ────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=unicampus-erp-files

# ─── Email (BullMQ / SMTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@unicampus.app
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=UniCampus ERP

# ─── Frontend & CORS ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXTAUTH_SECRET=change_me_nextauth_secret_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://34.236.107.120:3000,http://34.236.107.120:8081,https://*.unicampus.app

# ─── Throttler Rate Limiting ─────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=
